<% tracker = DesignAnnotations.tracker %>
<% if tracker %>
  <div data-controller="annotation-overlay">
    <script type="application/json" id="design-annotation-tree"><%= ERB::Util.json_escape(tracker.tree.to_json).html_safe %></script>
    <button type="button" data-action="click->annotation-overlay#toggle" class="design-annotation-toggle">Annotate</button>
    <button type="button" data-action="click->annotation-overlay#cycleTargetMode" data-annotation-overlay-target="modeButton" class="design-annotation-mode">Mode: Component</button>
    <div class="design-annotation-panel" data-annotation-overlay-target="panel"></div>
    <template data-annotation-overlay-target="popoverTemplate">
      <div class="design-annotation-popover">
        <div class="design-annotation-popover-header" data-annotation-overlay-target="popoverHeader"></div>
        <textarea data-annotation-overlay-target="popoverInput" placeholder="Comment…"></textarea>
        <details class="design-annotation-popover-debug">
          <summary>Debug</summary>
          <div data-annotation-overlay-target="popoverDebug"></div>
        </details>
        <div class="design-annotation-popover-actions">
          <button type="button" data-action="click->annotation-overlay#savePopover">Save</button>
          <button type="button" data-action="click->annotation-overlay#cancelPopover">Cancel</button>
        </div>
      </div>
    </template>
    <style><%= DesignAnnotations::Stylesheets::OVERLAY.html_safe %></style>
  </div>
<% end %>
