<%
  enabled = DesignAnnotations.tracker.present?
  css_class = enabled ? "design-annotation-activator is-on" : "design-annotation-activator"
  label = enabled ? "Disable annotations" : "Enable annotations"
  onclick = "var on=document.cookie.split('; ').some(function(c){return c.indexOf('design_annotate=1')===0;});" \
            "document.cookie=on?'design_annotate=; path=/; max-age=0':'design_annotate=1; path=/; max-age=2592000';" \
            "window.location.assign(window.location.pathname+window.location.search);return false;"
%>
<button type="button"
        id="design-annotation-activator"
        class="<%= css_class %>"
        data-turbo="false"
        onclick="<%= onclick.html_safe %>"><%= label %></button>
<style><%= DesignAnnotations::Stylesheets::ACTIVATOR.html_safe %></style>
